{
  "name": "sandos-federated-module",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "preview": "vite preview --host 0.0.0.0 --port 5175",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "@sand-enterpriseai/module-context": "0.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@module-federation/vite": "1.13.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.1.7"
  }
}
